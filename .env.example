# Copy to .env.local for local use, and add the same names in Vercel → Settings → Environment Variables.

# Public site address (share links, sitemap)
NEXT_PUBLIC_SITE_URL=https://prisain-tech.vercel.app

# Signed agreements: saved to Supabase (run supabase/agreements.sql first)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Signed agreements: emailed to you with the PDF (resend.com)
RESEND_API_KEY=
AGREEMENT_NOTIFY_EMAIL=you@example.com
# Optional once your domain is verified in Resend, e.g. PrisainTech <agreements@prisaintech.com>
RESEND_FROM=
